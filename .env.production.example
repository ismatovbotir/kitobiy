# Production .env for cPanel shared hosting (MySQL + cPanel mailbox SMTP).
# Copy to .env on the server, fill in the blanks, then run: php artisan key:generate

APP_NAME=Kitobiy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.uz
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Databases: names get the account prefix, e.g. cpuser_kitobiy
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
# Emails are sent straight away over SMTP, so no queue worker is needed. One cron job
# runs the weekly catalog import and daily overdue reminders: * * * * * cd /path/to/app && php artisan schedule:run
QUEUE_CONNECTION=sync
CACHE_STORE=database

# cPanel → Email Accounts: create noreply@your-domain.uz, then "Connect Devices" shows these values.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.your-domain.uz
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.uz
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.uz"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: the Telegram bot. Without a token and username, Telegram simply stays hidden.
# The username has no @. The secret is any long random text you make up, then run once:
# php artisan kitobiy:telegram-webhook
# For the login button, also tell @BotFather your domain with /setdomain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: a Google Books API key (Google Cloud → APIs → Books API). Without it,
# lookups share Google's per-IP quota, which a shared host may run out of.
GOOGLE_BOOKS_KEY=
